---
import { tagColor } from '../../utils/projectTags';

interface Props {
  title: string;
  image: string;
  url?: string;
  animationDelay?: number;
  inProgress?: boolean;
  tags?: string[];
}

const { title, image, url, animationDelay = 0, inProgress = false, tags = [] } = Astro.props;

const Tag = url ? 'a' : 'div';
---

<Tag
  href={url}
  class={`project-card animate-fadeInUp${inProgress ? ' project-card--in-progress' : ''}`}
  style={`animation-delay: ${animationDelay}s;`}
>
  {inProgress && <span class="project-card-badge">In Progress</span>}
  <div class="project-card-image-wrapper">
    <img src={image} alt={title} class="project-card-image" loading="lazy" />
    <div class="project-card-overlay"></div>
  </div>
  <div class="project-card-content">
    <h3 class="project-card-title">{title}</h3>
    {tags.length > 0 && (
      <div class="project-card-tags">
        {tags.map((tag) => {
          const color = tagColor(tag);
          return (
            <span
              class="project-card-tag"
              style={`--chip-dark: ${color.dark}; --chip-light: ${color.light};`}
            >
              {tag}
            </span>
          );
        })}
      </div>
    )}
  </div>
</Tag>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    background-color: transparent;
    position: relative;
    cursor: pointer;
  }

  .project-card--in-progress {
    cursor: default;
    opacity: 0.7;
  }

  .project-card--in-progress:hover {
    border-color: rgba(255, 255, 255, 0.1);
    transform: none;
    box-shadow: none;
  }

  :global([data-theme="light"]) .project-card--in-progress:hover {
    border-color: rgba(0, 0, 0, 0.3);
    box-shadow: none;
  }

  .project-card--in-progress:hover .project-card-image {
    transform: none;
  }

  .project-card--in-progress:hover .project-card-overlay {
    opacity: 0;
  }

  .project-card--in-progress:hover .project-card-content {
    background-color: rgba(255, 255, 255, 0.02);
  }

  :global([data-theme="light"]) .project-card--in-progress:hover .project-card-content {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .project-card--in-progress:hover .project-card-title {
    color: var(--color-text);
  }

  .project-card-badge {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 1;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: rgb(160, 90, 0);
    color: rgb(255, 220, 120);
    border: 1.5px solid rgb(255, 185, 50);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  :global([data-theme="light"]) .project-card-badge {
    background-color: rgb(120, 60, 0);
    color: rgb(255, 225, 140);
    border-color: rgb(200, 130, 20);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  :global([data-theme="light"]) .project-card {
    border: 1px solid rgba(0, 0, 0, 0.3);
  }

  .project-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 255, 153, 0.15);
  }

  :global([data-theme="light"]) .project-card:hover {
    box-shadow: 0 8px 24px rgba(22, 187, 140, 0.2);
  }

  .project-card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .project-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card:hover .project-card-image {
    transform: scale(1.05);
  }

  .project-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 60%,
      rgba(0, 0, 0, 0.4) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-card-overlay {
    opacity: 1;
  }

  .project-card-content {
    padding: 1.25rem;
    background-color: rgba(255, 255, 255, 0.02);
    transition: background-color 0.3s ease;
  }

  .project-card:hover .project-card-content {
    background-color: rgba(0, 255, 153, 0.05);
  }

  :global([data-theme="light"]) .project-card-content {
    background-color: rgba(0, 0, 0, 0.02);
  }

  :global([data-theme="light"]) .project-card:hover .project-card-content {
    background-color: rgba(22, 187, 140, 0.08);
  }

  .project-card-title {
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
    transition: color 0.3s ease;
    font-size: 1.125rem;
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .project-card-tag {
    --chip: var(--chip-dark);
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--chip);
    background-color: color-mix(in srgb, var(--chip) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--chip) 35%, transparent);
  }

  :global([data-theme="light"]) .project-card-tag {
    --chip: var(--chip-light);
    background-color: color-mix(in srgb, var(--chip) 10%, transparent);
    border-color: color-mix(in srgb, var(--chip) 40%, transparent);
  }

  .project-card:hover .project-card-title {
    color: var(--color-primary);
  }
</style>

