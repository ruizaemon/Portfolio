---
import { t } from '@/utils/i18n';
import StatusBadge from '../base/StatusBadge.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  /** Omitted for an in-progress post on the live site: the card is shown but not linked */
  url?: string;
  animationDelay: number;
  inProgress?: boolean;
  locale?: string;
}

const { title, description, pubDate, url, animationDelay, inProgress = false, locale = 'en' } = Astro.props;

const formattedDate = new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const Tag = url ? 'a' : 'div';
---

<Tag
  href={url}
  class:list={['post-card', 'animate-fadeInUp', { 'post-card--in-progress': inProgress, 'post-card--static': !url }]}
  style={`animation-delay: ${animationDelay}s;`}
>
  <article>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-description">{description}</p>
    <div class="post-card-meta">
      {inProgress && <StatusBadge label={t(locale, 'blog.inProgress')} />}
      <time class="post-card-date" datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
    </div>
  </article>
</Tag>

<style>
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem;
    border: 1px solid;
    border-radius: 8px;
    transition: all 0.3s ease;
    background-color: transparent;
  }

  .post-card:hover {
    border-color: var(--color-primary);
    background-color: rgba(0, 255, 153, 0.05);
    transform: translateY(-2px);
  }

  :global([data-theme="light"]) .post-card:hover {
    background-color: rgba(22, 187, 140, 0.08);
  }

  /* Still being written: a dashed amber outline, like a sketch of the finished card */
  .post-card--in-progress {
    border-style: dashed;
    border-color: rgba(255, 185, 50, 0.7);
  }

  :global([data-theme="light"]) .post-card--in-progress {
    border-color: rgba(200, 130, 20, 0.8);
  }

  /* Not linked (in-progress post on the live site): no hover, muted text */
  .post-card--static {
    cursor: default;
  }

  .post-card--static:hover {
    border-color: rgba(255, 185, 50, 0.7);
    background-color: transparent;
    transform: none;
  }

  :global([data-theme="light"]) .post-card--static:hover {
    border-color: rgba(200, 130, 20, 0.8);
    background-color: transparent;
  }

  .post-card--static .post-card-title,
  .post-card--static .post-card-description {
    opacity: 0.7;
  }

  .post-card article {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-card-title {
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  .post-card:hover .post-card-title {
    color: var(--color-primary);
  }

  .post-card--static:hover .post-card-title {
    color: var(--color-text);
  }

  .post-card-description {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .post-card-date {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
