---
import Navigation from "./Navigation.astro";
import LightDarkMode from "./LightDarkMode.astro";

const { title, locale = 'en' } = Astro.props;
---
<header>
  <p class="site-title">
    <a href={`/${locale}/`} class="home-link">{title}</a>
  </p>
  <LightDarkMode />
  <nav>
    <Navigation />
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Match the default h1 look this replaced (one h1 per page belongs to the content) */
  .site-title {
    font-size: 2em;
    font-weight: bold;
    margin: 0.67em 0;
  }

  .home-link {
    color: var(--color-text);
    text-decoration: none;
  }

  nav {
    margin-left: auto;
  }
</style>