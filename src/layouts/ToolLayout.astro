---
import BaseLayout from './BaseLayout.astro';
import { t } from '@/utils/i18n';
import { tagColor } from '@/utils/projectTags';
import LastUpdated from '@/components/main/LastUpdated.astro';
// Styles and fonts for the typeset formulas in tool write-ups ($…$ and $$…$$)
import 'katex/dist/katex.min.css';
// Shared write-up styles: table of contents, explainers, tables, diagrams
import '@/styles/writeup.css';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    lang: 'en' | 'ja';
    tags?: string[];
    updatedDate?: Date;
  };
}

const { frontmatter } = Astro.props;
const locale = frontmatter.lang;
const tags = frontmatter.tags ?? [];
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} wide>
  <article class="tool-article">
    <header class="tool-header">
      <a href={`/${locale}/projects/`} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t(locale, 'common.back')}
      </a>
      <h1 class="tool-title animate-fadeInUp">{frontmatter.title}</h1>
      {frontmatter.updatedDate && (
        <LastUpdated date={frontmatter.updatedDate} locale={locale} class="animate-fadeInUp" style="animation-delay: 0.05s;" />
      )}
      <p class="tool-description animate-fadeInUp" style="animation-delay: 0.05s;">{frontmatter.description}</p>
      {tags.length > 0 && (
        <div class="tool-tags animate-fadeInUp" style="animation-delay: 0.1s;">
          {tags.map((tag) => {
            const color = tagColor(tag);
            return (
              <span
                class="tool-tag"
                style={`--chip-dark: ${color.dark}; --chip-light: ${color.light};`}
              >
                {tag}
              </span>
            );
          })}
        </div>
      )}
    </header>

    <div class="tool-app animate-fadeInUp" style="animation-delay: 0.2s;">
      <slot name="tool" />
    </div>

    <div class="tool-content writeup animate-fadeInUp" style="animation-delay: 0.3s;">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  // Sections of the write-up are <details class="fold"> (see rehypeFoldSections).
  // A link to a heading inside a folded section would otherwise scroll to nothing,
  // so open every folded ancestor of the target before the browser jumps to it.
  function openFoldsFor(hash: string) {
    if (!hash || hash.length < 2) return;
    let target: Element | null = null;
    try {
      target = document.getElementById(decodeURIComponent(hash.slice(1)));
    } catch {
      return;
    }
    let el = target?.parentElement ?? null;
    while (el) {
      if (el instanceof HTMLDetailsElement && el.classList.contains('fold')) el.open = true;
      el = el.parentElement;
    }
  }

  openFoldsFor(location.hash);
  window.addEventListener('hashchange', () => openFoldsFor(location.hash));
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest('a[href*="#"]');
    if (!(link instanceof HTMLAnchorElement)) return;
    if (link.origin !== location.origin || link.pathname !== location.pathname) return;
    openFoldsFor(link.hash);
  });
</script>

<style>
  .tool-article {
    width: 100%;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .tool-title {
    font-size: 2.5rem;
    margin-top: 0.83em;
    margin-bottom: 0.75rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  .tool-description {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tool-tag {
    --chip: var(--chip-dark);
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--chip);
    background-color: color-mix(in srgb, var(--chip) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--chip) 35%, transparent);
  }

  :global([data-theme="light"]) .tool-tag {
    --chip: var(--chip-light);
    background-color: color-mix(in srgb, var(--chip) 10%, transparent);
    border-color: color-mix(in srgb, var(--chip) 40%, transparent);
  }

  .tool-app {
    margin: 2rem 0;
  }

  .tool-content {
    line-height: 1.8;
    color: var(--color-text);
  }

  .tool-content :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  /* Sub-sections (e.g. "App server", "Database"): a divider marks where each starts */
  .tool-content :global(h3) {
    font-size: 1.3rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  :global([data-theme="light"]) .tool-content :global(h3) {
    border-top-color: rgba(0, 0, 0, 0.15);
  }

  /* Individual parameters (e.g. "vCPU", "RAM"): accent color so they're easy to scan */
  .tool-content :global(h4) {
    font-size: 1.05rem;
    color: var(--color-primary);
    margin-top: 1.75rem;
    margin-bottom: 0.375rem;
  }

  /* Explanations inside a section (e.g. "Why sync workers cost so much more"):
     a different color so they don't read as another parameter */
  .tool-content :global(h5) {
    font-size: 1rem;
    color: var(--color-secondary);
    margin-top: 1.75rem;
    margin-bottom: 0.375rem;
  }

  /* Collapsible sections: rehypeFoldSections wraps each h2/h3 section in
     <details class="fold"> with the heading in its <summary>. The heading keeps
     its usual look and gains a chevron; clicking it folds the section */
  .tool-content :global(details.fold > summary) {
    display: block;
    cursor: pointer;
    list-style: none;
  }

  .tool-content :global(details.fold > summary::-webkit-details-marker) {
    display: none;
  }

  .tool-content :global(details.fold > summary > :is(h2, h3)) {
    position: relative;
    padding-right: 1.5rem;
  }

  /* Chevron that points down when open and right when closed */
  .tool-content :global(details.fold > summary > :is(h2, h3)::after) {
    content: '';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: -0.4rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    opacity: 0.6;
    transform: rotate(45deg);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* The h3 has a divider and padding above it, so its box centre sits low */
  .tool-content :global(details.fold > summary > h3::after) {
    margin-top: 0.35rem;
  }

  .tool-content :global(details.fold:not([open]) > summary > :is(h2, h3)::after) {
    transform: rotate(-45deg);
  }

  .tool-content :global(details.fold > summary:hover > :is(h2, h3)::after) {
    opacity: 1;
  }

  .tool-content :global(details.fold > summary:focus-visible) {
    outline: none;
  }

  .tool-content :global(details.fold > summary:focus-visible > :is(h2, h3)) {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* A folded h3 keeps its divider but drops the space its body used to leave below */
  .tool-content :global(details.fold:not([open]) > summary > h3) {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-content :global(details.fold > summary > :is(h2, h3)::after) {
      transition: none;
    }
  }

  /* Keep a heading visually attached to its text */
  .tool-content :global(h4 + p),
  .tool-content :global(h5 + p) {
    margin-top: 0;
  }

  .tool-content :global(h3 + h4),
  .tool-content :global(h3 + p + h4),
  .tool-content :global(details.fold-3 > .fold-body > h4:first-child),
  .tool-content :global(details.fold-3 > .fold-body > p:first-child + h4) {
    margin-top: 1.25rem;
  }

  .tool-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .tool-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .tool-content :global(code) {
    /* The site font is already monospace; the browser's default one renders smaller */
    font-family: inherit;
    background-color: rgba(0, 255, 153, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* Code blocks (syntax-highlighted by Astro) */
  .tool-content :global(pre) {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .tool-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  /* Display formulas ($$…$$ in the markdown, typeset by KaTeX): a tinted box
     with a green edge, scrolling sideways if a long one doesn't fit */
  .tool-content :global(.katex-display) {
    width: fit-content;
    max-width: 100%;
    margin: 0 0 1.5rem;
    padding: 0.75em 1.1em;
    overflow-x: auto;
    overflow-y: hidden;
    border-left: 3px solid var(--color-primary);
    border-radius: 0 6px 6px 0;
    background-color: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .tool-content :global(.katex-display > .katex) {
    text-align: left;
  }

  .tool-content :global(.katex) {
    font-size: 1.1em;
  }

  .tool-content :global(ul),
  .tool-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .tool-content :global(li) {
    margin-bottom: 0.5rem;
  }
</style>
