---
import BaseLayout from './BaseLayout.astro';
import { t } from '@/utils/i18n';
import StatusBadge from '@/components/base/StatusBadge.astro';
// Shared write-up styles: table of contents, explainers, tables, diagrams
import '@/styles/writeup.css';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    lang: 'en' | 'ja';
    inProgress?: boolean;
  };
  readingTime?: number;
}

const { frontmatter, readingTime } = Astro.props;
const locale = frontmatter.lang;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} ogType="article" noindex={frontmatter.inProgress}>
  <article class="post-article">
    <header class="post-header">
      <a href={`/${locale}/blog/`} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t(locale, 'common.back')}
      </a>
      <h1 class="post-title animate-fadeInUp">{frontmatter.title}</h1>
      <div class="post-meta animate-fadeInUp" style="animation-delay: 0.1s;">
        <div class="post-meta-dates">
          <time datetime={frontmatter.pubDate.toISOString()}>
            {new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : 'en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            }).format(frontmatter.pubDate)}
          </time>
          {frontmatter.updatedDate && (
            <span class="updated-date">
              ({t(locale, 'blog.updated')}: {new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : 'en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              }).format(frontmatter.updatedDate)})
            </span>
          )}
        </div>
        <div class="post-meta-reading-time">
          {readingTime && (
            <span class="reading-time">
              {readingTime} {t(locale, 'blog.minRead')}
            </span>
          )}
        </div>
      </div>
    </header>
    {frontmatter.inProgress && (
      <aside class="post-wip animate-fadeInUp" style="animation-delay: 0.15s;">
        <StatusBadge label={t(locale, 'blog.inProgress')} />
        <p>{t(locale, 'blog.inProgressNotice')}</p>
      </aside>
    )}
    <div class="post-divider animate-fadeInUp" style="animation-delay: 0.2s;"></div>
    <div class="post-content writeup animate-fadeInUp" style="animation-delay: 0.3s;">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-article {
    /* An explicit width: as a flex item with auto margins the article would otherwise
       size to its content, and one long unbreakable line could widen the whole page */
    width: 100%;
    max-width: 85ch;
    margin: 0 auto;
    padding: 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .back-link svg {
    width: 16px;
    height: 16px;
  }

  .post-title {
    font-size: 2.5rem;
    margin-top: 0.83em; /* match the h2 default this heading had before becoming an h1 */
    margin-bottom: 1rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  .post-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: space-between;
    gap: 0.25rem;
  }

  .post-meta-dates {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .post-meta-reading-time {
    display: flex;
    align-items: flex-end;
  }

  .reading-time {
    color: var(--color-text-muted);
  }

  .updated-date {
    font-style: italic;
  }

  /* "Still being written" notice under the title of an in-progress post */
  .post-wip {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px dashed rgb(255, 185, 50);
    border-radius: 8px;
    background-color: rgba(255, 185, 50, 0.06);
  }

  :global([data-theme="light"]) .post-wip {
    border-color: rgb(200, 130, 20);
    background-color: rgba(200, 130, 20, 0.06);
  }

  .post-wip p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .post-wip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  .post-divider {
    height: 1px;
    background-color: var(--color-text-muted);
    margin: 2rem 0;
  }

  .post-content {
    line-height: 1.8;
    color: var(--color-text);
    padding-bottom: 4rem;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .post-content :global(h1) {
    font-size: 2rem;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
  }

  .post-content :global(h3) {
    font-size: 1.3rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .post-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .post-content :global(code) {
    background-color: rgba(0, 255, 153, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* A long inline command (`openssl s_client -connect …`) may break mid-token on narrow screens */
  .post-content :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }

  /* Code blocks (syntax-highlighted by Astro) */
  .post-content :global(pre) {
    background-color: var(--color-background);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  :global([data-theme="light"]) .post-content :global(pre) {
    border-color: rgba(0, 0, 0, 0.15);
  }

  /* Inside a block the inline-code tint would paint every line; the block is the box */
  .post-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
</style>

